{
  "$schema": "https://schema.tauri.app/config/2.0.0",
  "productName": "远程控制客户端",
  "version": "1.0.0",
  "identifier": "com.remotecontrol.client",
  "build": {
    "frontendDist": "dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "远程控制客户端",
        "width": 600,
        "height": 500,
        "minWidth": 500,
        "minHeight": 400,
        "resizable": true,
        "center": true,
        "decorations": true,
        "alwaysOnTop": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/icon.png"]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
} 